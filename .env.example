# SBS/BaseStation del decodificador; no es el puerto IIO del Pluto.
SBS_HOST=127.0.0.1
SBS_PORT=30003
PORT=3001
HOST=127.0.0.1
# Posición opcional de tu antena; deja ambas vacías si no la has configurado.
RECEIVER_LAT=
RECEIVER_LON=
# IP del Pluto+ para el sondeo de diagnóstico (TCP a :80 y :30431, sin enviar datos). Vacía desactiva el sondeo.
PLUTO_HOST=192.168.2.1
